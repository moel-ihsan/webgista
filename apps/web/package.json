{
  "name": "@webgista/web",
  "version": "2.0.0-foundation",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "\"$NODE\" node_modules/vite/bin/vite.js",
    "build": "\"$NODE\" node_modules/vue-tsc/bin/vue-tsc.js --noEmit && \"$NODE\" node_modules/vite/bin/vite.js build",
    "preview": "\"$NODE\" node_modules/vite/bin/vite.js preview",
    "type-check": "\"$NODE\" node_modules/vue-tsc/bin/vue-tsc.js --noEmit",
    "lint": "\"$NODE\" node_modules/eslint/bin/eslint.js . --cache --cache-location node_modules/.cache/eslint",
    "lint:fix": "npm run lint -- --fix",
    "test": "\"$NODE\" node_modules/vitest/vitest.mjs run",
    "test:watch": "\"$NODE\" node_modules/vitest/vitest.mjs",
    "verify": "\"$NODE\" node_modules/vue-tsc/bin/vue-tsc.js --noEmit && \"$NODE\" node_modules/eslint/bin/eslint.js . --cache --cache-location node_modules/.cache/eslint && \"$NODE\" node_modules/vitest/vitest.mjs run && \"$NODE\" node_modules/vite/bin/vite.js build"
  },
  "dependencies": {
    "maplibre-gl": "6.16.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.14"
  }
}
