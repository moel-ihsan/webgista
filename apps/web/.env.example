# Public browser configuration from Supabase Project Settings > API.
# Never use an sb_secret_ key or legacy service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Set true only after the approved private-media migration is applied to the target project.
VITE_SUPABASE_PRIVATE_MEDIA_ENABLED=false
# Set true only after the profile-fields migration is applied to the target project.
VITE_SUPABASE_PROFILE_FIELDS_ENABLED=false
# Enable only after migration 010 has been approved and applied.
VITE_SUPABASE_ROI_DENSITY_ENABLED=false
# Set true only after the agency-membership RESTRICT migration is applied.
VITE_AGENCY_REMOVAL_ENABLED=false
